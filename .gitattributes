# === Unity asset files: DO NOT TOUCH LINE ENDINGS ===
*.unity  -text
*.mat    -text
*.asset  -text
*.prefab -text
*.anim   -text
*.controller -text
*.lighting -text
*.meta   -text

# === Code files: normalize to LF ===
*.cs     text eol=lf
*.shader text eol=lf
*.hlsl   text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf